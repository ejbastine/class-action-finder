# Only needed for `run --match`. Prefer `python -m caf key set` (Windows Credential Manager).
ANTHROPIC_API_KEY=

# Optional overrides
# CAF_GMAIL_ACCOUNT=you@gmail.com  # which Gmail the report's "Search Gmail" links open (default: first signed-in account)
# CAF_MODEL=claude-opus-5          # claude-sonnet-5 or claude-haiku-4-5 cost less per run
# CAF_EFFORT=low
# CAF_MAX_RUN_COST_USD=3.00
# CAF_REPORT_PATH=C:\Users\you\Documents\class-action-report.html
